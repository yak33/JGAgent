# 正式环境链接常量；当前环境由构建脚本或 CI 注入 ZCODE_ENV。
# JGHarness 去官方化：官方地址全部换为不解析占位域（.invalid），与 packages/shared/src/zcodeEndpoint.ts
# 的默认常量一致；公司服务就绪后在此替换。构建时 Vite 会把这些值注入渲染层的 import.meta.env。
ZCODE_PRODUCTION_BASE_URL=https://jgharness.invalid
ZAI_PRODUCTION_OAUTH_ORIGIN=https://zai-oauth.invalid
ZAI_PRODUCTION_BUSINESS_BASE_URL=https://zai-business.invalid
# 账号域已摘除；client_id 仅为保持文件结构而保留占位。
ZAI_PRODUCTION_OAUTH_CLIENT_ID=jgharness-oauth-production-placeholder
