# 服务地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# JGAgent 去官方化：默认值均为不解析占位域（.invalid），公司服务就绪后替换为真实地址。
ZCODE_BASE_URL=https://jgagent.invalid
BIGMODEL_API_BASE_URL=https://bigmodel.invalid
ZAI_OAUTH_ORIGIN=https://zai-oauth.invalid
ZAI_BUSINESS_BASE_URL=https://zai-business.invalid
# OAuth client id 占位；接入公司账号体系时替换。
ZAI_OAUTH_CLIENT_ID=jgagent-oauth-placeholder
ZCODE_CDN_BASE_URL=https://cdn.jgagent.invalid

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://jgagent.invalid/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn.jgagent.invalid/jgagent/electron/releases/0.1.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
